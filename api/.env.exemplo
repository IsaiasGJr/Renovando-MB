# Copie para api/.env e preencha. NUNCA coloque o .env no Git.
# Em produção: NODE_ENV=production. Só use NODE_ENV=development no seu computador (ativa o código 123456 e o pagamento simulado).
NODE_ENV=production
PORTA=3333
# Atrás de proxy/HTTPS (Caddy, Nginx, Cloudflare...): 1
TRUST_PROXY=1

# 32+ caracteres aleatórios, DIFERENTE do admin. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SEGREDO=
# Segredo do webhook do gateway de pagamento (24+ caracteres)
WEBHOOK_SEGREDO=

# Criptografia de CPF/WhatsApp/PIX: gere com "npm run gerar-chaves". IGUAIS às do admin. Guarde no cofre de senhas.
CHAVE_CRIPTOGRAFIA=
CHAVE_INDICE=

# Pasta do banco e das imagens (padrão: ./dados na raiz do projeto)
# DADOS_DIR=/srv/renovando/dados

# ---------- Código de login pelo WhatsApp (WhatsApp Cloud API / Meta) ----------
# Sem isto, em produção ninguém consegue entrar no app (o código não é enviado).
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
# Nome do modelo de mensagem de AUTENTICAÇÃO aprovado no WhatsApp Manager (com botão "Copiar código")
WHATSAPP_MODELO=codigo_login
WHATSAPP_IDIOMA=pt_BR

# ---------- Pagamento PIX ----------
# desligado = ofertas fechadas (padrão). Quando o gateway for integrado, use o nome dele (ver compartilhado/src/pagamentos.ts).
PIX_PROVEDOR=desligado

# ---------- Avisos no celular (opcional) ----------
# Só se "Enhanced push security" estiver ligado no projeto da Expo.
# EXPO_ACCESS_TOKEN=

# Endereço público desta API: vai no QR Code dos panfletos das igrejas
URL_PUBLICA=https://api.renovandoavinhadosenhor.com
