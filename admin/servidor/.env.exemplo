# Copie para admin/servidor/.env e preencha. NUNCA coloque o .env no Git.
NODE_ENV=production
PORTA=4000
TRUST_PROXY=1

# 32+ caracteres aleatórios, DIFERENTE do da API.
JWT_SEGREDO=

# Primeiro administrador (criado só se ainda não existir nenhum). Troque a senha depois do primeiro acesso.
ADMIN_EMAIL=
ADMIN_SENHA=

# IGUAIS às da API (npm run gerar-chaves).
CHAVE_CRIPTOGRAFIA=
CHAVE_INDICE=

# DADOS_DIR=/srv/renovando/dados
