# Copie para admin/servidor/.env e preencha. NUNCA coloque o .env no Git.
NODE_ENV=production
PORTA=4000
TRUST_PROXY=1

# 32+ caracteres aleatórios, DIFERENTE do da API.
JWT_SEGREDO=

# Primeiro administrador (criado só se ainda não existir nenhum). Troque a senha depois do primeiro acesso.
ADMIN_EMAIL=
ADMIN_SENHA=

# IGUAIS às da API (npm run gerar-chaves).
CHAVE_CRIPTOGRAFIA=
CHAVE_INDICE=

# DADOS_DIR=/srv/renovando/dados

# 1 = todo usuário do painel precisa ativar a verificação em duas etapas (recomendado em produção)
ADMIN_2FA_OBRIGATORIO=1

# Avisos no celular enviados pelo admin (opcional, igual ao da API)
# EXPO_ACCESS_TOKEN=

# Endereço público da API do app: o QR Code do panfleto abre a página da igreja lá
URL_PUBLICA_API=https://api.renovandoavinhadosenhor.com
